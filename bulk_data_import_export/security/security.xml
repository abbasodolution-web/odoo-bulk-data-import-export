<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_bulk_data" model="ir.module.category">
        <field name="name">Bulk Import / Export</field>
        <field name="sequence">90</field>
    </record>

    <record id="group_bulk_data_user" model="res.groups">
        <field name="name">User: own jobs</field>
        <field name="category_id" ref="module_category_bulk_data"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_bulk_data_manager" model="res.groups">
        <field name="name">Administrator: all jobs</field>
        <field name="category_id" ref="module_category_bulk_data"/>
        <field name="implied_ids" eval="[(4, ref('group_bulk_data_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_bulk_data_manager'))]"/>
    </record>

    <record id="rule_import_job_own" model="ir.rule">
        <field name="name">Bulk import: own jobs</field>
        <field name="model_id" ref="model_bulk_import_job"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_bulk_data_user'))]"/>
    </record>
    <record id="rule_import_job_all" model="ir.rule">
        <field name="name">Bulk import: all jobs</field>
        <field name="model_id" ref="model_bulk_import_job"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_bulk_data_manager'))]"/>
    </record>
    <record id="rule_export_job_own" model="ir.rule">
        <field name="name">Bulk export: own jobs</field>
        <field name="model_id" ref="model_bulk_export_job"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_bulk_data_user'))]"/>
    </record>
    <record id="rule_export_job_all" model="ir.rule">
        <field name="name">Bulk export: all jobs</field>
        <field name="model_id" ref="model_bulk_export_job"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_bulk_data_manager'))]"/>
    </record>
</odoo>
